generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "windows"]
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  schemas  = ["user", "document", "bp"]
}

model user {
  id         Int       @id() @default(autoincrement())
  id_role    Int?
  name       String?
  email      String?   @unique(map: "UQ__user__AB6E61649A5D8E7D")
  password   String?   @db.VarChar(255)
  created_at DateTime?
  updated_at DateTime?

  user_role user_role? @relation(fields: [id_role], references: [id])

  @@index([id])
  @@schema("user")
}

model user_role {
  id   Int     @id() @default(autoincrement())
  role String? @db.VarChar(20)

  user user[]

  @@index([id])
  @@schema("user")
}

model document {
  id              Int       @id() @default(autoincrement())
  title           String?
  id_category     Int?
  id_status       Int?
  id_bp           Int?
  nomer_pengajuan String?
  bl_code         String?
  bs_code         String?
  created_by      String?
  updated_by      String?
  created_at      DateTime?
  updated_at      DateTime?

  document_attachment document_attachment[]
  document_category   document_category?    @relation(fields: [id_category], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_status     document_status?      @relation(fields: [id_status], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_partner    business_partner?     @relation(fields: [id_bp], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id])
  @@schema("document")
}

model document_category {
  id         Int       @id() @default(autoincrement())
  category   String?
  created_by String?
  updated_by String?
  created_at DateTime?
  updated_at DateTime?

  document document[]

  @@index([id])
  @@schema("document")
}

model document_status {
  id     Int     @id() @default(autoincrement())
  status String?

  document document[]

  @@index([id])
  @@schema("document")
}

model document_attachment {
  id              Int       @id @default(autoincrement())
  id_doc          Int?
  file_attachment String?   @db.VarChar(300)
  description     String?   @db.VarChar(300)
  last_updated_by Int?
  created_by      String?
  updated_by      String?
  created_at      DateTime?
  updated_at      DateTime?

  document document? @relation(fields: [id_doc], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id])
  @@schema("document")
}

model business_partner {
  id      Int     @id() @default(autoincrement())
  name    String?
  address String?
  contact String?
  code    String?

  document document[]

  @@index([id])
  @@schema("document")
}
